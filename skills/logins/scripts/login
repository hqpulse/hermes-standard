#!/usr/bin/env python3
"""Fetch this assistant's own logins from the door on the controller.

    login list                 title, username and site, one login per line
    login show <title>         the site, then the username
    login password <title>     the password, and nothing else
    login otp <title>          the current authenticator code, and nothing else

What this file is, and what it is not:

  ONE VAULT, THIS ASSISTANT'S. The pod holds no 1Password token. It holds
  HERMES_LOGINS_TOKEN, which the controller resolves to one person and one
  vault, so there is no argument to this script that reaches anybody else's
  logins.

  THE TOKEN GOES TO THE DOOR AND NOWHERE ELSE. It rides one unredirected
  Authorization header; environment proxies are ignored and a redirect is
  refused outright, so no answer from the door can bounce it to another host.
  It appears in no output, no error and no traceback.

  A VALUE, NOT A SENTENCE. `password` and `otp` print the value alone with no
  label, so the caller can pipe it straight into a field. Everything the script
  wants to SAY goes to stderr, so a captured stdout is never a message.

  REFUSALS ARE PLAIN LINES. No logins here at all is exit 2 with a sentence the
  assistant can say to the person as it stands. Anything else the door refuses
  is exit 1 carrying the door's own plain reason.

The door's contract (hermes-fleet, the pod door):
  GET  /v1/logins        200 {"items": [...]}; no vault is 200 {"items": []}
  POST /v1/logins/read   200 {"value": "..."}; no vault is 404 with the detail
                         NO_VAULT_DETAIL below, exactly; an unknown title is
                         404 "no login with that title"

Standard library only: the pack ships no dependencies to a pod.
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request

DEFAULT_BASE = "http://hermes-fleet:8787"
TIMEOUT_S = 10

NO_VAULT_DETAIL = "no vault for this assistant"

NO_LOGINS = "this assistant has no logins yet; ask the Pulse team to add one"
NO_KEY = ("this pod has no login key, so the logins store cannot be asked; "
          "tell the Pulse team (it is not an empty list)")
BAD_TOKEN = "this assistant's login key is not accepted; tell the Pulse team"
NO_DOOR = "the logins service is not reachable right now"
BAD_BODY = "the logins service sent back an answer this script cannot read"
REDIRECTED = "the logins service tried to send this request elsewhere; refused"
BUSY = "the logins service is busy; wait a minute before asking again"
NO_TITLE = "no login with that title"

USAGE = "usage: login list | login show <title> | login password <title> | login otp <title>"


class RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """A redirect from the door is never followed: the token would go with it."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, msg, headers, fp)


OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), RefuseRedirects())


def die(message: str, code: int) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def call(path: str, body: dict | None = None) -> object:
    """One request to the door. Returns the decoded JSON, or exits with a reason."""
    token = os.environ.get("HERMES_LOGINS_TOKEN", "").strip()
    if not token:
        # A missing key is a fleet fault, never "no logins": on 11 Sep 2026 the
        # engine scrubbed the key from the terminal and every assistant told
        # its person it had no logins while its vault held one.
        die(NO_KEY, 3)
    base = os.environ.get("HERMES_FLEET_URL", "").strip().rstrip("/") or DEFAULT_BASE
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(base + path, data=data, method="POST" if data else "GET")
    request.add_unredirected_header("Authorization", "Bearer " + token)
    if data is not None:
        request.add_header("Content-Type", "application/json")
    try:
        with OPENER.open(request, timeout=TIMEOUT_S) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        raise SystemExit(refuse(error))
    except (urllib.error.URLError, OSError, ValueError):
        die(NO_DOOR, 1)
    try:
        return json.loads(raw.decode())
    except (UnicodeDecodeError, ValueError):
        die(BAD_BODY, 1)


def refuse(error: urllib.error.HTTPError) -> int:
    """Turn the door's refusal into a plain line and an exit code."""
    detail = ""
    try:
        payload = json.loads(error.read().decode() or "{}")
        if isinstance(payload, dict) and isinstance(payload.get("detail"), str):
            detail = payload["detail"].strip()
    except (OSError, ValueError, AttributeError):
        detail = ""
    if 300 <= error.code < 400:
        message, code = REDIRECTED, 1
    elif error.code == 401:
        message, code = BAD_TOKEN, 1
    elif error.code == 404 and detail == NO_VAULT_DETAIL:
        message, code = NO_LOGINS, 2
    elif error.code == 429:
        message, code = detail or BUSY, 1
    else:
        message, code = detail or f"the logins service refused this ({error.code})", 1
    print(message, file=sys.stderr)
    return code


def items() -> list:
    payload = call("/v1/logins")
    rows = payload.get("items") if isinstance(payload, dict) else payload
    if not isinstance(rows, list):
        die(BAD_BODY, 1)
    return [row for row in rows if isinstance(row, dict)]


def read(title: str, field: str) -> str:
    payload = call("/v1/logins/read", {"title": title, "field": field})
    value = payload.get("value") if isinstance(payload, dict) else None
    if not isinstance(value, str) or not value:
        die(f"the logins service returned no {field} for that login", 1)
    return value


def main(argv: list) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        die(USAGE, 1)
    command, rest = argv[0], argv[1:]
    if command == "list":
        if rest:
            die(USAGE, 1)
        rows = items()
        if not rows:
            die(NO_LOGINS, 2)
        for row in rows:
            print("\t".join(str(row.get(key) or "") for key in ("title", "username", "url")))
        return 0
    if command in ("show", "password", "otp"):
        if len(rest) != 1 or not rest[0].strip():
            die(USAGE, 1)
        title = rest[0]
        if command == "show":
            rows = items()
            if not rows:
                die(NO_LOGINS, 2)
            row = next((r for r in rows if r.get("title") == title), None)
            if row is None:
                die(NO_TITLE, 1)
            print(str(row.get("url") or ""))
            print(str(row.get("username") or ""))
        else:
            print(read(title, command))
        return 0
    die(USAGE, 1)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
